# Shared template for local development configuration.
# Copy to .env locally; never commit real secrets or connection credentials.
# Empty backend settings fall back to safe development defaults.
# Fill MODEL_API_KEY locally before calling the model.

# General application settings
APP_ENV=development
LOG_LEVEL=INFO

# Application metadata/users/sessions database: SQLite for the local MVP.
# Sensitive field: must be empty in repository template; defaults to sqlite:///./var/app.db
APP_DATABASE_URL=
DATASETS_DATA_DIR=./var/data/datasets
RESULTS_DATA_DIR=./var/data/results

# Explicit one-owner mode for local CP1. Standalone backend defaults to false.
# Compose fixes these to true/cp1-local-user and stores all data in its named volume.
CP1_LOCAL_MODE=false
CP1_LOCAL_USER_ID=cp1-local-user
# Compose publishes the UI only on 127.0.0.1.
DJEDAI_PORT=8080

# OpenAI-compatible API: include the full provider-specific base path (for example /v1).
MODEL_BASE_URL=https://api.deepinfra.com/v1/openai
# PL-1: open weights, Apache-2.0, 35B total parameters, provider FP8.
# Model identifier must match the configured endpoint.
MODEL_NAME=Qwen/Qwen3.6-35B-A3B
# Required for model calls; fill locally and never commit a real key.
# For a local server without authentication, use its accepted placeholder value.
MODEL_API_KEY=
# Exact weights revision when running a local model.
MODEL_REVISION=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=2048
# Application context budget; history/catalog reduction is implemented in #77.
MODEL_CONTEXT_TOKENS=8192

# Execution and query safety limits (§4.4, §7.4)
TYPE_PARSE_THRESHOLD=0.95
RELATION_MIN_OVERLAP=0.5
RELATION_UNNAMED_MIN_OVERLAP=0.95
RELATION_MIN_JACCARD=0.5
SQL_MAX_ROWS=5000
TOOL_TIMEOUT_SECONDS=30.0
# Total calls across all widgets and prerequisite steps in one refresh.
DASHBOARD_MAX_TOOL_CALLS=20

# Network policy: comma-separated list of allowed outbound hostnames
ALLOWED_OUTBOUND_HOSTS=

# Reserved for future signing; AUTH-1 opaque DB sessions do not use this secret.
# Sensitive field: must be empty in repository template; defaults to dev secret
SESSION_SECRET=

# Demo PostgreSQL (infra/postgres/README.md); used only by the seed script and integration tests.
# Sensitive fields: must be empty in repository template.
DJEDAI_DEMO_PG_LOADER_DSN=
DJEDAI_TEST_PG_DSN=

# Public frontend build-time API base; VITE_* values are visible in the browser.
# Compose uses /api; Vite dev proxy targets http://localhost:8000.
# Never put server secrets in VITE_* variables.
VITE_API_BASE_URL=/api

# Backend-only explicit CORS allowlist for development origins (no wildcard).
# Comma-separated list of allowed frontend dev origins; blank enables nothing.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
