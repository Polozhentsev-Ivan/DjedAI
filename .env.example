# Shared template, not working application configuration yet.
# Copy to .env locally; never commit real secrets or connection credentials.
# Variable names must be agreed when the configuration layer is implemented.
# Empty values below must not be treated as production defaults.

# General application settings
APP_ENV=development
LOG_LEVEL=INFO

# Application metadata/users database: choose its engine and fill in the DSN.
# This is not a shared connection to a user's analytical dataset.
APP_DATABASE_URL=

# Local model endpoint and the exact model/weights revision
MODEL_BASE_URL=
MODEL_NAME=
MODEL_REVISION=

# Agree limits before enabling them; the specification has provisional values.
SQL_MAX_ROWS=
TOOL_TIMEOUT_SECONDS=

# Network policy: agree domains and enforcement in the infrastructure task.
# An empty value does not itself implement an outbound-network restriction.
ALLOWED_OUTBOUND_HOSTS=

# Fill locally only if the agreed session mechanism requires this secret.
SESSION_SECRET=
