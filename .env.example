# Shared template for local development configuration.
# Copy to .env locally; never commit real secrets or connection credentials.
# Empty values will fall back to safe application defaults.

# General application settings
APP_ENV=development
LOG_LEVEL=INFO

# Application metadata/users database: choose its engine and fill in the DSN.
# Sensitive field: must be empty in repository template; defaults to sqlite:///./var/app.db
APP_DATABASE_URL=

# Local model endpoint and the exact model/weights revision
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct
MODEL_REVISION=

# Execution and query safety limits (§4.4, §7.4)
SQL_MAX_ROWS=5000
TOOL_TIMEOUT_SECONDS=30.0

# Network policy: comma-separated list of allowed outbound hostnames
ALLOWED_OUTBOUND_HOSTS=

# Session / JWT signing secret for local development
# Sensitive field: must be empty in repository template; defaults to dev secret
SESSION_SECRET=

# Public frontend build-time API base; VITE_* values are visible in the browser.
# Root-template loading and Vite dev proxy will be implemented in B4-1 / #83.
# Never put server secrets in VITE_* variables.
VITE_API_BASE_URL=/api

# Backend-only explicit CORS allowlist for development origins (no wildcard).
# Comma-separated list of allowed frontend dev origins; blank enables nothing.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
