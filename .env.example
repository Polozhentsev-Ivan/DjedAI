# Shared template for local development configuration.
# Copy to .env locally; never commit real secrets or connection credentials.
# Empty backend settings fall back to safe development defaults.
# Fill MODEL_API_KEY locally before calling the model.

# General application settings
APP_ENV=development
LOG_LEVEL=INFO

# Application metadata/users/sessions database: SQLite for the local MVP.
# Sensitive field: must be empty in repository template; defaults to sqlite:///./var/app.db
APP_DATABASE_URL=
DATASETS_DATA_DIR=./var/data/datasets
RESULTS_DATA_DIR=./var/data/results
# Operator-only structured journal; Compose keeps it in the app-data volume.
DIAGNOSTICS_DIR=./var/diagnostics
DIAGNOSTICS_MAX_BYTES=10000000
DIAGNOSTICS_BACKUPS=5
# Fernet key for persisted database-source credentials; generate and retain outside Git.
# Empty disables new PostgreSQL/ClickHouse connections; CSV remains available.
SOURCE_ENCRYPTION_KEY=
# ClickHouse tables are copied into the dataset up to this total volume (decision #61).
CLICKHOUSE_MAX_ROWS=10000000
CLICKHOUSE_MAX_BYTES=1000000000
CLICKHOUSE_QUERY_TIMEOUT_SECONDS=300

# Legacy bootstrap utility only; never bypasses Bearer auth on resource APIs.
# Compose disables bootstrap and stores data in its named volume.
CP1_LOCAL_MODE=false
CP1_LOCAL_USER_ID=cp1-local-user
# Compose publishes the UI only on 127.0.0.1.
DJEDAI_PORT=8080

# OpenAI-compatible API: include the full provider-specific base path (for example /v1).
MODEL_BASE_URL=https://api.deepinfra.com/v1/openai
# PL-1: open weights, Apache-2.0, 35B total parameters, provider FP8.
# Model identifier must match the configured endpoint.
MODEL_NAME=Qwen/Qwen3.6-35B-A3B
# Required for model calls; fill locally and never commit a real key.
# For a local server without authentication, use its accepted placeholder value.
MODEL_API_KEY=
# Exact weights revision when running a local model.
MODEL_REVISION=
# Model settings in the interface (#209). Keep false on a server reached over the network:
# the key must not travel through the browser, and changing the address would send user
# data to an arbitrary host. With false only the model is chosen in the interface, from
# MODEL_ALLOWED_NAMES; the key and address come only from this file (PUT with them -> 403).
# Set true only for a local single-user run: the key, address and model are then set in the
# interface, stored encrypted with SOURCE_ENCRYPTION_KEY (required for the key) and take
# precedence over MODEL_BASE_URL/MODEL_NAME/MODEL_API_KEY. Empty fields fall back to this file.
MODEL_SETTINGS_FROM_UI=false
# Models offered in the interface: comma-separated or a JSON array. MODEL_NAME is always allowed.
# MODEL_REASONING_SUPPORTED, MODEL_*_PRICE_* and ALLOW_DATA_SHARING below are confirmed only
# for MODEL_BASE_URL + MODEL_NAME: for another pair chosen in the interface they are turned off.
MODEL_ALLOWED_NAMES=
# Wall-clock limit for one HTTP attempt: >0 and <=600 seconds.
MODEL_TIMEOUT_SECONDS=60
# All stages, retries and tool calls of one question: >0 and <=600 seconds.
AGENT_TURN_TIMEOUT_SECONDS=120
# Additional attempts per model call: 0..3. SDK retries are disabled.
MODEL_MAX_RETRIES=1
# Initial exponential backoff: 0..10 seconds; Retry-After also respects the budget.
MODEL_RETRY_DELAY_SECONDS=0.5
MODEL_MAX_OUTPUT_TOKENS=2048
# Application context budget; history/catalog reduction is implemented in #77.
MODEL_CONTEXT_TOKENS=8192
# Per-stage reasoning for a reasoning-capable model: provider_default|none|low|medium|high.
# provider_default omits reasoning_effort and keeps the previous provider/model behaviour.
# DeepInfra accepts reasoning_effort only on models that expose reasoning.
MODEL_REASONING_UNDERSTAND=provider_default
MODEL_REASONING_PLAN=provider_default
MODEL_REASONING_VISUALIZE=provider_default
MODEL_REASONING_COMPOSE=provider_default
MODEL_REASONING_VERIFY=provider_default
# Support is model/endpoint-specific. Confirmed for the default DeepInfra
# Qwen/Qwen3.6-35B-A3B endpoint on 2026-10-25; set true only for that pair
# after rechecking, or when another endpoint is explicitly verified.
# With false, any non-default stage setting fails at startup instead of being silently ignored.
MODEL_REASONING_SUPPORTED=false
# Optional estimated cost: set all three together; no default/actual billing is assumed.
MODEL_INPUT_PRICE_PER_MILLION_USD=
MODEL_OUTPUT_PRICE_PER_MILLION_USD=
# Include tariff date, provider/model and source; update when changing model or tier.
MODEL_PRICE_REFERENCE=
# Data transfer policy (#173). false is the safe default: metadata, user question/history,
# facts, aggregates and current-result cell values are sent; catalog samples/top values and
# raw rows from previous turns are not. true additionally allows those samples and
# historical rows for a trusted endpoint. Secrets, DSNs, passwords and tokens are never
# sent in either mode.
# This flag does not disable the agreed external inference (see docs/decisions/47).
ALLOW_DATA_SHARING=false

# Generate Russian column/table descriptions for new datasets with the model (B1-6).
# A model failure only adds a catalog warning; the statistical catalog is still published.
CATALOG_DESCRIPTIONS=true

# Execution and query safety limits (§4.4, §7.4)
TYPE_PARSE_THRESHOLD=0.95
RELATION_MIN_OVERLAP=0.5
RELATION_UNNAMED_MIN_OVERLAP=0.95
RELATION_MIN_JACCARD=0.5
SQL_MAX_ROWS=5000
TOOL_TIMEOUT_SECONDS=30.0
# Total calls across all widgets and prerequisite steps in one refresh.
DASHBOARD_MAX_TOOL_CALLS=20
# Hours after which a live PostgreSQL profile is reported as aged in answers (#169).
CATALOG_MAX_AGE_HOURS=24

# Network policy: comma-separated list of allowed outbound hostnames
ALLOWED_OUTBOUND_HOSTS=

# Reserved for future signing; AUTH-1 opaque DB sessions do not use this secret.
# Sensitive field: must be empty in repository template; defaults to dev secret
SESSION_SECRET=

# Demo databases, Compose profile "demo" (infra/README.md#демо-бд-postgresql-и-clickhouse).
# Roles are created from these passwords on the first start of an empty volume.
# Sensitive fields: must be empty in repository template.
DEMO_PG_ADMIN_PASSWORD=
DEMO_PG_LOADER_PASSWORD=
DEMO_PG_READER_PASSWORD=
DEMO_CH_ADMIN_PASSWORD=
DEMO_CH_LOADER_PASSWORD=
DEMO_CH_READER_PASSWORD=
DEMO_PG_PORT=55432
DEMO_CH_HTTP_PORT=58123

# Seed/verify scripts and integration tests only; the backend never reads these.
# Sensitive fields: must be empty in repository template; URLs embed passwords too.
DJEDAI_DEMO_PG_LOADER_DSN=
DJEDAI_DEMO_PG_READER_DSN=
DJEDAI_DEMO_CH_LOADER_URL=
DJEDAI_DEMO_CH_READER_URL=
DJEDAI_TEST_PG_DSN=
DJEDAI_TEST_CH_URL=

# Public frontend build-time API base; VITE_* values are visible in the browser.
# Compose uses /api; Vite dev proxy targets http://localhost:8000.
# Never put server secrets in VITE_* variables.
VITE_API_BASE_URL=/api

# Backend-only explicit CORS allowlist for development origins (no wildcard).
# Comma-separated list of allowed frontend dev origins; blank enables nothing.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per backend process: attempts per client address and auth endpoint in a fixed window.
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
