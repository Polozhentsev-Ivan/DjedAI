      "plan": [
        {
          "tool": "run_sql",
          "args": {
            "sql": "WITH chain_stats AS (\n    SELECT\n        kod_tsepochki_zapuskov,\n        ANY_VALUE(zadanie) AS zadanie,\n        MAX(CASE WHEN status = 'Успешно' THEN 1 ELSE 0 END) AS has_success,\n        MAX(CASE WHEN nomer_popytki = 1 AND status = 'Успешно' THEN 1 ELSE 0 END) AS first_success,\n        MAX(nomer_popytki) AS max_attempts\n    FROM \"08_fonovye_zadaniya\"\n    GROUP BY kod_tsepochki_zapuskov\n),\nretry_success AS (\n    SELECT\n        kod_tsepochki_zapuskov,\n        zadanie,\n        max_attempts,\n        (has_success = 1 AND first_success = 0) AS is_retry_success\n    FROM chain_stats\n)\nSELECT\n    zadanie,\n    COUNT(DISTINCT kod_tsepochki_zapuskov) AS total_chains,\n    COUNT(DISTINCT CASE WHEN is_retry_success THEN kod_tsepochki_zapuskov END) AS retry_success_chains,\n    COUNT(DISTINCT CASE WHEN is_retry_success THEN kod_tsepochki_zapuskov END) * 1.0 / COUNT(DISTINCT kod_tsepochki_zapuskov) AS share_retry_success,\n    AVG(CASE WHEN is_retry_success THEN max_attempts END) AS avg_attempts_retry_success\nFROM retry_success\nGROUP BY zadanie\nORDER BY share_retry_success DESC"
          }
        }
      ],
