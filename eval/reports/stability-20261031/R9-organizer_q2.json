   "plan": [
    {
     "tool": "run_sql",
     "args": {
      "sql": "WITH monthly_rev AS (\n  SELECT\n    gorod,\n    strftime(data_operatsii_msk, '%Y-%m') as ym,\n    SUM(kolichestvo_sht * tsena_do_skidki_za_edinitsu_rub * (1.0 - skidka / 100.0)) as net_rev\n  FROM \"01_prodazhi\"\n  WHERE strftime(data_operatsii_msk, '%Y-%m') IN ('2025-02', '2025-03')\n  GROUP BY 1, 2\n),\npivoted AS (\n  SELECT\n    gorod,\n    MAX(CASE WHEN ym = '2025-02' THEN net_rev END) as feb_rev,\n    MAX(CASE WHEN ym = '2025-03' THEN net_rev END) as mar_rev\n  FROM monthly_rev\n  GROUP BY 1\n)\nSELECT\n  gorod,\n  feb_rev,\n  mar_rev,\n  (mar_rev - feb_rev) / NULLIF(feb_rev, 0) * 100.0 as growth_pct\nFROM pivoted\nWHERE feb_rev IS NOT NULL AND mar_rev IS NOT NULL\nORDER BY growth_pct DESC\nLIMIT 1"
     }
    }
   ],
