   "plan": [
    {
     "tool": "run_sql",
     "args": {
      "sql": "WITH monthly AS (\n    SELECT\n        gorod,\n        strftime(data_operatsii_msk, '%Y-%m') AS ym,\n        SUM(kolichestvo_sht * tsena_do_skidki_za_edinitsu_rub * (1.0 - skidka / 100.0)) AS rev\n    FROM \"01_prodazhi\"\n    WHERE data_operatsii_msk >= '2025-02-01' AND data_operatsii_msk < '2025-04-01'\n    GROUP BY gorod, ym\n),\npivot AS (\n    SELECT\n        gorod,\n        MAX(CASE WHEN ym = '2025-02' THEN rev END) AS feb_rev,\n        MAX(CASE WHEN ym = '2025-03' THEN rev END) AS mar_rev\n    FROM monthly\n    GROUP BY gorod\n)\nSELECT\n    gorod,\n    feb_rev,\n    mar_rev,\n    (mar_rev - feb_rev) / feb_rev * 100.0 AS growth_pct\nFROM pivot\nWHERE feb_rev IS NOT NULL AND mar_rev IS NOT NULL AND feb_rev != 0\nORDER BY growth_pct DESC\nLIMIT 1"
     }
    }
   ],
