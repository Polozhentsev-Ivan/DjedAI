  {
   "answer": "Сильнее всего выросло лекарство с ID 1019 (Цетиризин). Рост составил 30,32 %. \n\nРасчёт:\n1. Среднедневные продажи на аптеку в феврале 2025: 1,55 (общие продажи / (28 дней * количество аптек)).\n2. Среднедневные продажи на аптеку в марте 2025: 2,02 (общие продажи / (31 день * количество аптек)).\n3. Рост в процентах: (2,02 - 1,55) / 1,55 * 100 = 30,32 %.",
   "used_tools": [
    "run_sql"
   ],
   "fact_checks": [
    {
     "key": "medicine.growth_percent",
     "comparison": "approx",
     "expected": 30.3211,
     "result": true,
     "passed": true,
     "source": "current"
    }
   ],
   "plan": [
    {
     "tool": "run_sql",
     "args": {
      "sql": "WITH monthly_stats AS (\n  SELECT\n    id_lekarstva,\n    deystvuyuschee_veschestvo,\n    CASE WHEN data < '2025-03-01' THEN 'feb' ELSE 'mar' END AS month,\n    SUM(skol_ko_kupili) AS total_sales,\n    COUNT(DISTINCT id_apteki) AS num_pharmacies\n  FROM \"09_lekarstvennye_preparaty\"\n  WHERE data >= '2025-02-01' AND data < '2025-04-01'\n  GROUP BY 1, 2, 3\n),\npivoted AS (\n  SELECT\n    id_lekarstva,\n    deystvuyuschee_veschestvo,\n    MAX(CASE WHEN month = 'feb' THEN total_sales / (28.0 * num_pharmacies) END) AS avg_feb,\n    MAX(CASE WHEN month = 'mar' THEN total_sales / (31.0 * num_pharmacies) END) AS avg_mar\n  FROM monthly_stats\n  GROUP BY 1, 2\n)\nSELECT\n  id_lekarstva,\n  deystvuyuschee_veschestvo,\n  avg_feb,\n  avg_mar,\n  (avg_mar - avg_feb) / avg_feb * 100.0 AS growth_pct\nFROM pivoted\nWHERE avg_feb > 0 AND avg_mar IS NOT NULL\nORDER BY growth_pct DESC\nLIMIT 1"
     }
    }
   ],
