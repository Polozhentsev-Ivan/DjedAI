     "tool": "run_sql",
     "args": {
      "sql": "SELECT\n  id_lekarstva,\n  SUM(CASE WHEN data >= '2025-02-01' AND data < '2025-03-01' THEN skol_ko_kupili ELSE 0 END) / 28.0 AS feb_avg,\n  SUM(CASE WHEN data >= '2025-03-01' AND data < '2025-04-01' THEN skol_ko_kupili ELSE 0 END) / 31.0 AS mar_avg,\n  (SUM(CASE WHEN data >= '2025-03-01' AND data < '2025-04-01' THEN skol_ko_kupili ELSE 0 END) / 31.0 - SUM(CASE WHEN data >= '2025-02-01' AND data < '2025-03-01' THEN skol_ko_kupili ELSE 0 END) / 28.0) / NULLIF(SUM(CASE WHEN data >= '2025-02-01' AND data < '2025-03-01' THEN skol_ko_kupili ELSE 0 END) / 28.0, 0) * 100 AS growth_pct\nFROM \"09_lekarstvennye_preparaty\"\nGROUP BY id_lekarstva\nHAVING feb_avg > 0\nORDER BY growth_pct DESC\nLIMIT 1"
     }
    }
   ],
