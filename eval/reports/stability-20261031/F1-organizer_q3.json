  {
   "answer": "Максимальный 90-й перцентиль времени решения среди групп поддержки с не менее чем 100 закрытыми обращениями в марте 2025 года у группы **«Доставка заказов»**. Значение перцентиля составляет **72,49 часа** (по 4 515 обращениям).",
   "used_tools": [
    "run_sql"
   ],
   "fact_checks": [
    {
     "key": "group",
     "comparison": "exact",
     "expected": "Доставка заказов",
     "result": true,
     "passed": true,
     "source": "current"
    },
    {
     "key": "group.p90_hours",
     "comparison": "approx",
     "expected": 72.555,
     "result": true,
     "passed": true,
     "source": "current"
    }
   ],
   "plan": [
    {
     "tool": "run_sql",
     "args": {
      "sql": "WITH closed_march AS (\n    SELECT\n        gruppa_podderzhki,\n        date_diff('second', sozdano_msk, zakryto_msk) / 3600.0 AS resolution_hours\n    FROM \"02_tekhnicheskaya_podderzhka\"\n    WHERE zakryto_msk >= '2025-03-01' AND zakryto_msk < '2025-04-01'\n),\ngroup_stats AS (\n    SELECT\n        gruppa_podderzhki,\n        COUNT(*) AS cnt,\n        quantile_cont(resolution_hours, 0.9) AS p90_hours\n    FROM closed_march\n    GROUP BY gruppa_podderzhki\n    HAVING COUNT(*) >= 100\n)\nSELECT\n    gruppa_podderzhki,\n    p90_hours,\n    cnt\nFROM group_stats\nORDER BY p90_hours DESC\nLIMIT 1"
     }
    }
   ],
