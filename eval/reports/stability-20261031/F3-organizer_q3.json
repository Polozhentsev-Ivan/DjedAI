     "args": {
      "sql": "SELECT gruppa_podderzhki, quantile_cont(date_diff('second', sozdano_msk, zakryto_msk) / 3600.0, 0.9) AS p90_hours FROM \"02_tekhnicheskaya_podderzhka\" WHERE zakryto_msk >= '2025-03-01' AND zakryto_msk < '2025-04-01' GROUP BY gruppa_podderzhki HAVING COUNT(*) >= 100 ORDER BY p90_hours DESC LIMIT 1"
