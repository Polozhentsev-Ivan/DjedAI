  {
   "answer": "Сильнее всего выросло лекарство **Цетиризин** (ID: 1019). Рост среднедневных продаж на аптеку составил **30,32 %**.\n\n**Расчёт:**\n1. Среднедневные продажи в феврале 2025: 1,55 (общие продажи / (количество аптек × 28 дней)).\n2. Среднедневные продажи в марте 2025: 2,02 (общие продажи / (количество аптек × 31 день)).\n3. Рост в процентах: ((2,02 - 1,55) / 1,55) × 100 = 30,32 %.",
   "used_tools": [
    "run_sql"
   ],
   "fact_checks": [
    {
     "key": "medicine.growth_percent",
     "comparison": "approx",
     "expected": 30.3211,
     "result": true,
     "passed": true,
     "source": "current"
    }
   ],
   "plan": [
    {
     "tool": "run_sql",
     "args": {
      "sql": "WITH monthly_stats AS (\n    SELECT\n        id_lekarstva,\n        ANY_VALUE(deystvuyuschee_veschestvo) AS deystvuyuschee_veschestvo,\n        CASE WHEN data >= '2025-02-01' AND data < '2025-03-01' THEN 'feb'\n             WHEN data >= '2025-03-01' AND data < '2025-04-01' THEN 'mar'\n        END AS month,\n        SUM(skol_ko_kupili) AS total_sales,\n        COUNT(DISTINCT id_apteki) AS num_pharmacies\n    FROM \"09_lekarstvennye_preparaty\"\n    WHERE data >= '2025-02-01' AND data < '2025-04-01'\n    GROUP BY 1, 3\n),\npivot AS (\n    SELECT\n        id_lekarstva,\n        deystvuyuschee_veschestvo,\n        MAX(CASE WHEN month = 'feb' THEN total_sales END) AS feb_sales,\n        MAX(CASE WHEN month = 'feb' THEN num_pharmacies END) AS feb_pharm,\n        MAX(CASE WHEN month = 'mar' THEN total_sales END) AS mar_sales,\n        MAX(CASE WHEN month = 'mar' THEN num_pharmacies END) AS mar_pharm\n    FROM monthly_stats\n    GROUP BY 1, 2\n),\ncalcs AS (\n    SELECT\n        id_lekarstva,\n        deystvuyuschee_veschestvo,\n        feb_sales, feb_pharm, mar_sales, mar_pharm,\n        feb_sales / NULLIF(feb_pharm * 28.0, 0) AS feb_avg,\n        mar_sales / NULLIF(mar_pharm * 31.0, 0) AS mar_avg,\n        (mar_sales / NULLIF(mar_pharm * 31.0, 0) - feb_sales / NULLIF(feb_pharm * 28.0, 0)) / (feb_sales / NULLIF(feb_pharm * 28.0, 0)) * 100.0 AS growth_pct\n    FROM pivot\n    WHERE feb_avg IS NOT NULL AND mar_avg IS NOT NULL\n)\nSELECT\n    id_lekarstva,\n    deystvuyuschee_veschestvo,\n    feb_avg,\n    mar_avg,\n    growth_pct\nFROM calcs\nORDER BY growth_pct DESC\nLIMIT 1"
     }
    }
   ],
