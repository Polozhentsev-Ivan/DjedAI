      "sql": "SELECT\n    gruppa_podderzhki,\n    quantile_cont(date_diff('second', sozdano_msk, zakryto_msk) / 3600.0, 0.9) AS p90_hours,\n    COUNT(*) AS cnt\nFROM \"02_tekhnicheskaya_podderzhka\"\nWHERE zakryto_msk >= '2025-03-01' AND zakryto_msk < '2025-04-01'\nGROUP BY gruppa_podderzhki\nHAVING COUNT(*) > 100\nORDER BY p90_hours DESC\nLIMIT 1"
