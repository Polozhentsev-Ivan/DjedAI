     "tool": "run_sql",
     "params": {
      "sql": "WITH monthly_stats AS (\n  SELECT \n    id_lekarstva,\n    deystvuyuschee_veschestvo,\n    CASE \n      WHEN data >= '2025-02-01' AND data < '2025-03-01' THEN 'feb'\n      WHEN data >= '2025-03-01' AND data < '2025-04-01' THEN 'mar'\n    END AS month,\n    SUM(skol_ko_kupili) AS total_sales,\n    COUNT(DISTINCT id_apteki) AS num_pharmacies,\n    CASE \n      WHEN data >= '2025-02-01' AND data < '2025-03-01' THEN 28.0\n      WHEN data >= '2025-03-01' AND data < '2025-04-01' THEN 31.0\n    END AS days_in_month\n  FROM \"09_lekarstvennye_preparaty\"\n  WHERE data >= '2025-02-01' AND data < '2025-04-01'\n  GROUP BY 1, 2, 3, 5\n),\npivoted AS (\n  SELECT \n    feb.id_lekarstva,\n    feb.deystvuyuschee_veschestvo,\n    feb.total_sales AS feb_sales,\n    feb.num_pharmacies AS feb_pharmacies,\n    feb.days_in_month AS feb_days,\n    mar.total_sales AS mar_sales,\n    mar.num_pharmacies AS mar_pharmacies,\n    mar.days_in_month AS mar_days,\n    (mar.total_sales * 1.0 / mar.days_in_month / mar.num_pharmacies) AS mar_avg_daily_per_pharmacy,\n    (feb.total_sales * 1.0 / feb.days_in_month / feb.num_pharmacies) AS feb_avg_daily_per_pharmacy\n  FROM monthly_stats feb\n  JOIN monthly_stats mar ON feb.id_lekarstva = mar.id_lekarstva\n  WHERE feb.month = 'feb' AND mar.month = 'mar'\n)\nSELECT \n  id_lekarstva,\n  deystvuyuschee_veschestvo,\n  feb_avg_daily_per_pharmacy,\n  mar_avg_daily_per_pharmacy,\n  ROUND((mar_avg_daily_per_pharmacy - feb_avg_daily_per_pharmacy) / feb_avg_daily_per_pharmacy * 100, 2) AS growth_pct\nFROM pivoted\nORDER BY growth_pct DESC\nLIMIT 1"
