   "answer": "Сильнее всего выросло лекарство с ID 1019 (Цетиризин). Рост составил 30,32 %. \n\nРасчёт:\n1. Среднедневные продажи в феврале 2025: 61,86 (сумма продаж за февраль / 28 дней).\n2. Среднедневные продажи в марте 2025: 80,61 (сумма продаж за март / 31 день).\n3. Рост в процентах: (80,61 - 61,86) / 61,86 * 100 = 30,32 %.",
   "used_tools": [
    "run_sql",
    "run_sql"
   ],
   "fact_checks": [
    {
     "key": "medicine.growth_percent",
     "comparison": "approx",
     "expected": 30.3211,
     "result": true,
     "passed": true,
     "source": "current"
    }
   ],
   "plan": [
    {
     "tool": "run_sql",
     "args": {
      "sql": "WITH monthly_stats AS (\n  SELECT \n    id_lekarstva,\n    ANY_VALUE(deystvuyuschee_veschestvo) AS veschestvo,\n    CASE \n      WHEN data >= '2025-02-01' AND data < '2025-03-01' THEN 'feb'\n      WHEN data >= '2025-03-01' AND data < '2025-04-01' THEN 'mar'\n    END AS month,\n    SUM(skol_ko_kupili) AS total_sales\n  FROM \"09_lekarstvennye_preparaty\"\n  WHERE data >= '2025-02-01' AND data < '2025-04-01'\n  GROUP BY 1, 3\n),\npivoted AS (\n  SELECT \n    id_lekarstva,\n    veschestvo,\n    MAX(CASE WHEN month = 'feb' THEN total_sales / 28.0 ELSE NULL END) AS feb_avg,\n    MAX(CASE WHEN month = 'mar' THEN total_sales / 31.0 ELSE NULL END) AS mar_avg\n  FROM monthly_stats\n  GROUP BY 1, 2\n)\nSELECT \n  id_lekarstva,\n  veschestvo,\n  feb_avg,\n  mar_avg,\n  (mar_avg - feb_avg) / feb_avg * 100.0 AS growth_pct\nFROM pivoted\nWHERE feb_avg > 0 AND mar_avg IS NOT NULL\nORDER BY growth_pct DESC\nLIMIT 1"
     }
    }
   ],
