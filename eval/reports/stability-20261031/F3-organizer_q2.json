   "plan": [
    {
     "tool": "run_sql",
     "args": {
      "sql": "WITH monthly_revenue AS (\n    SELECT\n        gorod,\n        CAST(date_trunc('month', data_operatsii_msk) AS DATE) AS month,\n        SUM(kolichestvo_sht * tsena_do_skidki_za_edinitsu_rub * (1.0 - skidka / 100.0)) AS net_revenue\n    FROM \"01_prodazhi\"\n    WHERE data_operatsii_msk >= '2025-02-01' AND data_operatsii_msk < '2025-04-01'\n    GROUP BY gorod, CAST(date_trunc('month', data_operatsii_msk) AS DATE)\n),\npivot AS (\n    SELECT\n        gorod,\n        MAX(CASE WHEN month = DATE '2025-02-01' THEN net_revenue END) AS feb_revenue,\n        MAX(CASE WHEN month = DATE '2025-03-01' THEN net_revenue END) AS mar_revenue\n    FROM monthly_revenue\n    GROUP BY gorod\n)\nSELECT\n    gorod,\n    feb_revenue,\n    mar_revenue,\n    CASE WHEN feb_revenue != 0 THEN (mar_revenue - feb_revenue) / feb_revenue * 100.0 ELSE NULL END AS growth_pct\nFROM pivot\nWHERE feb_revenue IS NOT NULL AND mar_revenue IS NOT NULL\nORDER BY growth_pct DESC\nLIMIT 1"
     }
    }
   ],
