     "args": {
      "sql": "SELECT\n    perevozchik,\n    quantile_cont(GREATEST(0, date_diff('second', obeschannyy_srok_msk, dostavleno_msk) / 3600.0), 0.95) AS p95_delay_hours\nFROM \"04_dostavka\"\nWHERE dostavleno_msk >= '2025-03-01' AND dostavleno_msk < '2025-04-01'\nGROUP BY perevozchik\nORDER BY p95_delay_hours DESC\nLIMIT 1"
